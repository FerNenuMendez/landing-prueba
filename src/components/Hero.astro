---
import { Scissors, Calendar, Menu, ArrowRight, User } from '@lucide/astro';
import { BOOKING_URL, ADMIN_LOGIN_URL } from '../constants';
---

<header class="fixed top-0 left-0 right-0 z-50 px-4 py-4 md:px-8">
  <div class="max-w-7xl mx-auto flex items-center justify-between bg-[#0d0e15]/75 backdrop-blur-md border border-slate-800/80 px-6 py-3.5 rounded-full shadow-lg shadow-black/20">
    <a href="#" class="flex items-center gap-2 group">
      <div class="bg-violet-600 p-2 rounded-full text-white group-hover:rotate-45 transition-transform duration-300">
        <Scissors class="w-4 h-4" />
      </div>
      <span class="font-bold text-xl tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white to-slate-300">
        Peluquería <span class="text-violet-400">Carlitos</span>
      </span>
    </a>
    
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
      <a href="#servicios" class="hover:text-violet-400 transition-colors">Servicios</a>
      <a href="#elegirnos" class="hover:text-violet-400 transition-colors">Por qué elegirnos</a>
      <a href="#contacto" class="hover:text-violet-400 transition-colors">Contacto</a>
    </nav>
    
    <div class="flex items-center gap-2 sm:gap-3">
      <a 
        href={ADMIN_LOGIN_URL}
        target="_blank"
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-1.5 border border-slate-800/80 hover:border-slate-700 bg-slate-900/20 hover:bg-slate-800/40 text-slate-300 hover:text-white text-xs font-medium px-3.5 py-2.5 rounded-full transition-all duration-300"
        title="Acceso Admin"
      >
        <User class="w-3.5 h-3.5 text-slate-400" />
        <span class="hidden sm:inline">Acceso Admin</span>
      </a>

      <a 
        href={BOOKING_URL}
        target="_blank"
        rel="noopener noreferrer" 
        class="hidden sm:inline-flex items-center gap-1.5 bg-violet-600 hover:bg-violet-500 text-white text-xs font-semibold px-4.5 py-2.5 rounded-full transition-all duration-300 shadow-md shadow-violet-600/10 hover:shadow-violet-600/30"
      >
        <Calendar class="w-3.5 h-3.5" />
        Reservar Turno
      </a>
      
      <button class="md:hidden p-2 text-slate-300 hover:text-white" aria-label="Menu">
        <Menu class="w-6 h-6" />
      </button>
    </div>
  </div>
</header>

<section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Text Content -->
      <div class="lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-500/10 border border-violet-500/20 text-violet-400 text-xs font-semibold tracking-wide mb-6 uppercase">
          <span class="w-1.5 h-1.5 rounded-full bg-violet-400 animate-ping"></span>
          ✂️ Experiencia única en barbería
        </div>
        
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight text-white leading-tight mb-6">
          Tu estilo, <br />
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-violet-400 via-purple-400 to-indigo-400">
            nuestra especialidad
          </span>
        </h1>
        
        <p class="text-slate-300 text-base sm:text-lg md:text-xl max-w-xl mb-8 leading-relaxed font-light">
          Combinamos técnicas clásicas y tendencias modernas para darte el look que mereces. Atención personalizada, ambiente relajado y profesionales del más alto nivel.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
          <a
            href={BOOKING_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative inline-flex items-center justify-center gap-2 bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-500 hover:to-indigo-500 text-white font-bold px-8 py-4 rounded-xl transition-all duration-300 shadow-lg shadow-violet-600/25 hover:shadow-violet-600/40 hover:-translate-y-0.5 overflow-hidden"
          >
            <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:animate-[shimmer_1.5s_infinite]"></span>
            <Calendar class="w-5 h-5" />
            Reservar Turno Ahora
          </a>
          
          <a
            href="#servicios"
            class="inline-flex items-center justify-center gap-2 border border-slate-700 hover:border-slate-500 hover:bg-slate-800/40 text-slate-300 hover:text-white font-medium px-8 py-4 rounded-xl transition-all duration-300"
          >
            Ver Servicios
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>
        
        <div class="flex items-center gap-8 mt-10 text-xs sm:text-sm text-slate-400">
          <div class="flex flex-col">
            <span class="text-2xl font-bold text-white">4.9★</span>
            <span>Calificación Clientes</span>
          </div>
          <div class="w-px h-8 bg-slate-800"></div>
          <div class="flex flex-col">
            <span class="text-2xl font-bold text-white">+1,500</span>
            <span>Cortes Mensuales</span>
          </div>
          <div class="w-px h-8 bg-slate-800"></div>
          <div class="flex flex-col">
            <span class="text-2xl font-bold text-white">100%</span>
            <span>Satisfechos</span>
          </div>
        </div>
      </div>
      
      <!-- Visual Content -->
      <div class="lg:col-span-5 relative w-full max-w-md lg:max-w-none mx-auto">
        <!-- Decorative Glow Ring -->
        <div class="absolute -inset-1.5 bg-gradient-to-r from-violet-600 to-indigo-600 rounded-2xl blur opacity-30 group-hover:opacity-100 transition duration-1000 group-hover:duration-200 animate-tilt"></div>
        
        <div class="relative bg-[#0d0e15] border border-slate-800 rounded-2xl overflow-hidden shadow-2xl">
          <picture>
            <source srcset="/images/barber_hero.webp" type="image/webp" />
            <img 
              src="/images/barber_hero.png" 
              alt="Peluquería Carlitos Interior" 
              class="w-full aspect-[4/3] md:aspect-square object-cover opacity-90 hover:scale-105 transition-transform duration-700 ease-out"
              loading="eager"
              decoding="async"
              width="600"
              height="600"
            />
          </picture>
          <div class="absolute inset-0 bg-gradient-to-t from-[#090a0f] via-transparent to-transparent"></div>
          
          <!-- Floating Overlay Card -->
          <div class="absolute bottom-4 left-4 right-4 bg-[#0d0e15]/80 backdrop-blur-md border border-slate-800/80 p-4 rounded-xl flex items-center justify-between">
            <div>
              <p class="text-xs text-violet-400 font-semibold uppercase tracking-wider">¿Listo para un cambio?</p>
              <p class="text-sm font-bold text-white">Reservá en 1 minuto online</p>
            </div>
            <a 
              href={BOOKING_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-violet-600 hover:bg-violet-500 p-2 rounded-lg text-white transition-colors"
            >
              <Calendar class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
  @keyframes shimmer {
    100% {
      transform: translateX(100%);
    }
  }
</style>
