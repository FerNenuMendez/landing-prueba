---
import { Scissors, Zap, Award, Crown, Check, Calendar } from '@lucide/astro';
import { BOOKING_URL } from '../constants';

const services = [
  {
    name: 'Corte Clásico',
    description: 'Corte tradicional realizado a tijera y máquina. Estilo atemporal adaptado a tu fisonomía.',
    price: '$12.000',
    time: '35 min',
    icon: Scissors,
    features: ['Lavado post-corte', 'Peinado con cera premium', 'Asesoramiento de estilo']
  },
  {
    name: 'Degradado / Fade',
    description: 'Técnica de degradado ultra precisa (skin fade, mid fade, high fade) con navaja.',
    price: '$14.000',
    time: '45 min',
    icon: Zap,
    features: ['Degradado milimétrico', 'Lavado con shampoo tonificante', 'Styling personalizado']
  },
  {
    name: 'Perfilado de Barba',
    description: 'Diseño, recorte y perfilado a navaja con toallas calientes y aceites hidratantes.',
    price: '$10.000',
    time: '30 min',
    icon: Award,
    features: ['Ritual de toalla caliente', 'Afeitado al ras en contornos', 'Bálsamo hidratante']
  },
  {
    name: 'Combo Premium',
    description: 'El servicio completo para renovar tu imagen al 100%. Corte a elección y perfilado de barba.',
    price: '$20.000',
    time: '75 min',
    icon: Crown,
    features: ['Corte + Barba', 'Lavado y exfoliación facial', 'Bebida de cortesía gratis']
  }
];
---

<section id="servicios" class="py-20 md:py-28 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs uppercase tracking-widest text-violet-400 font-semibold mb-3">Nuestros Servicios</h2>
      <p class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">
        Servicios diseñados para el hombre moderno
      </p>
      <div class="w-12 h-1 bg-gradient-to-r from-violet-600 to-indigo-600 mx-auto rounded-full mb-6"></div>
      <p class="text-slate-400 text-base sm:text-lg">
        Seleccioná el servicio que mejor se adapte a tus necesidades. Calidad, precisión y atención al detalle garantizadas en cada turno.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {services.map((service) => {
        const Icon = service.icon;
        return (
          <div class="group relative flex flex-col justify-between bg-[#0d0e15]/40 backdrop-blur-sm border border-slate-800/80 rounded-2xl p-6 hover:border-violet-500/30 hover:bg-[#0d0e15]/75 hover:shadow-xl hover:shadow-violet-600/5 hover:-translate-y-1 transition-all duration-300">
            
            <div>
              <!-- Icon and Price Header -->
              <div class="flex items-center justify-between mb-6">
                <div class="bg-violet-950/40 border border-violet-500/20 text-violet-400 p-3 rounded-xl group-hover:scale-110 transition-transform duration-300">
                  <Icon class="w-5 h-5" />
                </div>
                <div class="text-right">
                  <span class="text-2xl font-bold text-white">{service.price}</span>
                  <p class="text-[10px] text-slate-500 uppercase tracking-wider">{service.time}</p>
                </div>
              </div>

              <!-- Content -->
              <h3 class="text-xl font-bold text-white mb-2 group-hover:text-violet-400 transition-colors">
                {service.name}
              </h3>
              <p class="text-slate-400 text-sm leading-relaxed mb-6 font-light">
                {service.description}
              </p>

              <!-- Features List -->
              <ul class="space-y-2.5 mb-8">
                {service.features.map((feature) => (
                  <li class="flex items-start gap-2 text-xs text-slate-300">
                    <span class="text-violet-400 mt-0.5 shrink-0">
                      <Check class="w-3.5 h-3.5" />
                    </span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Booking Button -->
            <a
              href={BOOKING_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 bg-slate-800 hover:bg-violet-600 group-hover:bg-violet-600 text-slate-200 group-hover:text-white font-semibold text-xs py-3 rounded-xl transition-all duration-300 border border-slate-700/50 group-hover:border-violet-500/20"
            >
              <Calendar class="w-4 h-4" />
              Reservar Turno
            </a>
          </div>
        );
      })}
    </div>

    <!-- Bottom Notice -->
    <div class="mt-16 text-center">
      <p class="text-slate-400 text-sm">
        ¿Tenés dudas sobre cuál elegir? 
        <a href="#contacto" class="text-violet-400 font-semibold hover:underline ml-1">
          Consultanos directamente
        </a>
      </p>
    </div>

  </div>
</section>
